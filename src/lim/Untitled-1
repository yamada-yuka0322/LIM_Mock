    "import astropy.io.fits as fits\n",
    "import astropy.units as u\n",
    "from astropy.cosmology import Planck18 as cosmo\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "def Get_Sides(file):\n",
    "    with fits.open(file) as hdu:\n",
    "        data = hdu[1].data\n",
    "        redshift = data['redshift']\n",
    "        Mstar = data['Mstar']  # [Msun]\n",
    "    m = redshift < 3.0\n",
    "    return redshift[m], Mstar[m]\n",
    "\n",
    "def Get_SMF(redshift, Mstar, zmin, zmax, area_deg2=1.0):\n",
    "    sel = (redshift > zmin) & (redshift < zmax)\n",
    "    M = Mstar[sel]\n",
    "\n",
    "    # --- volume for a pencil beam of area_deg2 ---\n",
    "    omega = (area_deg2 * u.deg**2).to(u.sr)                 # solid angle\n",
    "    V_shell_allsky = cosmo.comoving_volume(zmax) - cosmo.comoving_volume(zmin)  # full sky\n",
    "    V = (omega / (4*np.pi*u.sr)) * V_shell_allsky           # scale to your area\n",
    "    V = V.to(u.Mpc**3)\n",
    "\n",
    "    bins = np.linspace(7.0, 13.0, 25)\n",
    "    hist, bin_edges = np.histogram(np.log10(M), bins=bins)  # <- order fixed\n",
    "    dlogM = np.diff(bin_edges)\n",
    "\n",
    "    phi = hist / V.value / dlogM                            # [Mpc^-3 dex^-1]\n",
    "    centers = 0.5 * (bin_edges[1:] + bin_edges[:-1])\n",
    "    density = np.sum(sel)/V\n",
    "    return centers, phi, density\n",
    "\n",
    "def Get_SMF_sample(redshift, Mstar, zmin, zmax, area_deg2=1.0):\n",
    "    sel = (redshift > zmin) & (redshift < zmax)\n",
    "    M = Mstar[sel]\n",
    "\n",
    "    bins = np.linspace(7.0, 13.0, 25)\n",
    "    hist, bin_edges = np.histogram(np.log10(M), bins=bins)  # <- order fixed\n",
    "    dlogM = np.diff(bin_edges)\n",
    "\n",
    "    phi = hist / dlogM                            # [Mpc^-3 dex^-1]\n",
    "    centers = 0.5 * (bin_edges[1:] + bin_edges[:-1])\n",
    "    return centers, phi, np.sum(sel)\n",
    "\n",
    "file = '/mnt/data_cat3/yuka/data/SIDES/pySIDES_from_uchuu_tile_0_0.fits'\n",
    "z, Mstar = Get_Sides(file)\n",
    "\n",
    "x, y, count1 = Get_SMF(z, Mstar, 0.8, 1.2, area_deg2=1.0)\n",
    "plt.xlim(7, 14)\n",
    "plt.ylim(1e-6, 2e-1)\n",
    "plt.scatter(x, y)\n",
    "plt.yscale('log')\n",
    "plt.xlabel(r'$\\log_{10}(M_\\star/M_\\odot)$')\n",
    "plt.ylabel(r'$\\phi\\ [\\mathrm{Mpc^{-3}\\ dex^{-1}}]$')\n",
    "\n",
    "f_sample = \"/mnt/data_cat3/yuka/repository/LIM_mock/theta_samples_100000_seed1.npz\"\n",
    "data = np.load(f_sample, allow_pickle=True)\n",
    "samples = data[\"samples\"] #100000このsampleに対するSED parameter\n",
    "logM_samples = data[\"logM_samples\"] #remaining stellar mass (log M_sun)\n",
    "redshift = samples[:,-1]\n",
    "Mstar = 10**logM_samples\n",
    "total_area = len(z)/len(redshift)\n",
    "x, y, count2 = Get_SMF_sample(redshift, Mstar, 0.8, 1.2, area_deg2=1.0)\n",
    "plt.xlim(7, 14)\n",
    "plt.ylim(1e-6, 2e-1)\n",
    "plt.scatter(x, y*count1/count2)\n",
    "\n",
    "logM_formed = data[\"logM_formed\"] #remaining stellar mass (log M_sun)\n",
    "redshift = samples[:,-1]\n",
    "Mstar = 10**logM_formed\n",
    "total_area = len(z)/len(redshift)\n",
    "x, y, count2 = Get_SMF_sample(redshift, Mstar, 0.8, 1.2, area_deg2=1.0)\n",
    "total_area = len(z)/len(redshift)\n",
    "plt.scatter(x, y*count1/count2)\n",
    "\n",
    "zmean, logMknee, Phiknee1, Phiknee2, alpha1,  alpha2 = 9.4999998808E-01,  1.0704272270E+01,  2.4840966798E-03,  5.3109036526E-04,  -3.3000001311E-01,  -1.4900000095E+00\n",
    "phi = np.exp(-10**x/10**logMknee) * (Phiknee1*(10**x/10**logMknee)**alpha1 + Phiknee2*(10**x/10**logMknee)**alpha2) / 10**logMknee * 10**x * np.log(10)\n",
    "plt.plot(x, phi)\n",
    "plt.xlim(7, 14)\n",
    "plt.ylim(1e-6, 2e-1)\n",
    "plt.yscale('log')\n",
    "plt.xlabel(r'$\\log_{10}(M_\\star/M_\\odot)$')\n",
    "plt.ylabel(r'$\\phi\\ [\\mathrm{Mpc^{-3}\\ dex^{-1}}]$')\n",
    "plt.show()\n"
